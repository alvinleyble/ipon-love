<?xml version="1.0" encoding="utf-8"?>
<!-- Heart-Wallet launcher background: dark plum so the two-tone mark pops.
     Full-bleed 108x108; the OS mask supplies the rounded/circle shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18" android:startY="0"
                android:endX="90" android:endY="108"
                android:startColor="#3A1727"
                android:endColor="#1E0C15" />
        </aapt:attr>
    </path>
</vector>
