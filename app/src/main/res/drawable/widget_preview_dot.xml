<?xml version="1.0" encoding="utf-8"?>
<!-- A plain filled circle for the balance-widget picker preview's per-account color dots. Bare
     <View> elements aren't on the RemoteViews whitelist, so the launcher's picker fails to inflate
     the preview layout ("Can't load widget"); an ImageView showing this oval is whitelisted and
     is recolored per dot via android:tint. Only the static preview uses this — the live widget is
     Glance-drawn. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFF" />
    <size
        android:width="10dp"
        android:height="10dp" />
</shape>
